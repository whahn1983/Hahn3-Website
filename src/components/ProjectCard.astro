---
import Icon from './Icon.astro';
import SmartLink from './SmartLink.astro';
import type { Project } from '../data/content';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const headingId = `project-${project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<article class="card flex h-full flex-col p-6 sm:p-8" aria-labelledby={headingId}>
  <div class="flex flex-wrap items-center gap-3">
    <span class="text-sm font-medium text-slate-400">{project.kind}</span>
    <span
      class:list={[
        'rounded-full px-2.5 py-0.5 text-xs font-semibold',
        project.status === 'available'
          ? 'bg-emerald-400/10 text-emerald-300 ring-1 ring-emerald-400/30'
          : 'bg-amber-400/10 text-amber-200 ring-1 ring-amber-300/30',
      ]}
    >
      {project.status === 'available' ? 'Available' : 'In development'}
    </span>
  </div>
  <h4 id={headingId} class="mt-4 text-2xl font-bold text-white">
    {project.name}
  </h4>
  <p class:list={['mt-3 leading-relaxed text-slate-300', project.wide && 'max-w-4xl']}>
    {project.description}
  </p>
  {project.highlights && (
    <ul class:list={['mt-6 grid gap-x-10 gap-y-3', project.wide && 'lg:grid-cols-2']}>
      {project.highlights.map((item) => (
        <li class="flex gap-3 leading-relaxed text-slate-300">
          <Icon name="check" class="mt-1 size-5 shrink-0 text-accent-500" strokeWidth={2} />
          <span>{item}</span>
        </li>
      ))}
    </ul>
  )}
  {project.tags && (
    <ul class="mt-5 flex flex-wrap gap-2">
      {project.tags.map((tag) => (
        <li class="rounded-md border border-white/10 bg-white/5 px-2.5 py-1 text-sm text-slate-300">
          {tag}
        </li>
      ))}
    </ul>
  )}
  {project.note && <p class="mt-5 text-sm text-slate-400">{project.note}</p>}
  {project.links && project.links.length > 0 && (
    <ul class="mt-auto flex flex-wrap gap-x-6 gap-y-2 pt-6">
      {project.links.map((link) => (
        <li>
          <SmartLink href={link.href} class="text-link inline-flex items-center gap-2">
            {link.label}
            <Icon name="external" class="size-4" strokeWidth={2} />
          </SmartLink>
        </li>
      ))}
    </ul>
  )}
</article>
