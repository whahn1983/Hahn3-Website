---
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-midnight-950">
  <div class="mx-auto max-w-[86rem] px-5 py-12 sm:px-8 lg:px-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div>
        <a href="/#home" class="inline-block rounded-md" aria-label="Hahn3 — back to top">
          <Wordmark class="text-2xl" />
        </a>
        <p class="mt-2 text-sm text-slate-400">Engineering · Technology · Aerospace</p>
      </div>
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="text-slate-300 hover:text-white">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-6 border-t border-white/10 pt-8 text-sm text-slate-400 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl space-y-2">
        <p>
          &copy; {year} {site.name}. All rights reserved.
        </p>
        <p>
          This is a personal website; views are my own. H3 Consulting Partners is an independent
          business. NASA, Siemens, Infinite Flight, and other organizations are mentioned for
          professional context only and do not endorse this site.
        </p>
      </div>
      <a
        href="/#home"
        class="inline-flex shrink-0 items-center gap-2 font-medium text-slate-300 hover:text-white"
      >
        <Icon name="arrow-up" class="size-4" strokeWidth={2} />
        Back to top
      </a>
    </div>
  </div>
</footer>
