---
import { icons, type IconDef, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
  /** Provide a label only when the icon conveys meaning on its own. */
  label?: string;
  strokeWidth?: number;
}

const { name, class: className = 'size-5', label, strokeWidth = 1.6 } = Astro.props;
const icon: IconDef = icons[name];
const transform = icon.rotate ? `rotate(${icon.rotate} 12 12)` : undefined;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={icon.viewBox ?? '0 0 24 24'}
  class={className}
  fill={icon.fill ? 'currentColor' : 'none'}
  stroke={icon.fill ? 'none' : 'currentColor'}
  stroke-width={icon.fill ? undefined : (icon.strokeWidth ?? strokeWidth)}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <g transform={transform}>
    {icon.paths.map((d) => (
      <path d={d} />
    ))}
  </g>
</svg>
