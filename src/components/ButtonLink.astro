---
import Icon from './Icon.astro';
import SmartLink from './SmartLink.astro';
import type { IconName } from '../lib/icons';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  icon?: IconName;
  class?: string;
}

const { href, variant = 'primary', icon, class: className } = Astro.props;
---

<SmartLink
  href={href}
  class:list={[
    'inline-flex min-h-12 items-center justify-center gap-2.5 rounded-lg px-6 py-3 text-base font-semibold transition-colors',
    variant === 'primary'
      ? 'bg-accent-600 text-white shadow-lg shadow-black/30 hover:bg-accent-700'
      : 'border border-white/80 bg-midnight-950/20 text-white hover:border-white hover:bg-white/10',
    className,
  ]}
>
  <slot />
  {icon && <Icon name={icon} class="size-5" strokeWidth={2} />}
</SmartLink>
