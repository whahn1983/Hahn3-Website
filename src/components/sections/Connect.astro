---
import ContactEmail from '../ContactEmail.astro';
import Icon from '../Icon.astro';
import SmartLink from '../SmartLink.astro';
import type { IconName } from '../../lib/icons';
import { productLinks } from '../../data/content';
import { owner } from '../../data/site';

type Channel = {
  label: string;
  description: string;
  icon: IconName;
  /** External links, or `email` to render the client-assembled address. */
  links?: { label: string; href: string }[];
  email?: string;
};

// Channels without a configured value are left out automatically.
const channels: Channel[] = [
  ...(owner.contactEmail
    ? [
        {
          label: 'Email',
          description: 'For direct inquiries and introductions.',
          icon: 'mail' as const,
          email: owner.contactEmail,
        },
      ]
    : []),
  ...(owner.linkedinUrl
    ? [
        {
          label: 'LinkedIn',
          description: 'Professional profile and experience.',
          icon: 'linkedin' as const,
          links: [{ label: 'View profile', href: owner.linkedinUrl }],
        },
      ]
    : []),
  ...(owner.githubUrl
    ? [
        {
          label: 'GitHub',
          description: 'Code, tools, and personal projects.',
          icon: 'github' as const,
          links: [{ label: 'View profile', href: owner.githubUrl }],
        },
      ]
    : []),
  {
    label: 'H3 Consulting Partners',
    description: 'For advisory, automation, and data & AI engagements.',
    icon: 'briefcase',
    links: [{ label: 'h3consultingpartners.com', href: productLinks.h3 }],
  },
];
---

<section
  id="connect"
  aria-labelledby="connect-title"
  class="border-t border-white/5 bg-midnight-950/40"
>
  <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <div class="card relative overflow-hidden bg-[radial-gradient(ellipse_at_top_left,rgba(38,132,237,0.16),transparent_60%)] p-6 sm:p-10 lg:p-14">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-accent-300">Connect</p>
          <h2 id="connect-title" class="section-title mt-3">
            Let’s connect
          </h2>
          <span class="mt-5 block h-1 w-10 rounded-full bg-accent-500" aria-hidden="true"></span>
          <p class="mt-6 text-lg leading-relaxed text-slate-300">
            For consulting engagements, reach out through H3 Consulting Partners. For anything
            else—engineering, industrial technology, or building practical products—email me or
            connect on LinkedIn.
          </p>
        </div>

        <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
          {channels.map((channel) => (
            <li class="flex h-full flex-col rounded-xl border border-white/10 bg-midnight-900/60 p-6">
              <Icon name={channel.icon} class="size-8 text-accent-500" strokeWidth={1.5} />
              <h3 class="mt-4 text-lg font-semibold text-white">{channel.label}</h3>
              <p class="mt-1 text-slate-300">{channel.description}</p>
              <div class="mt-auto pt-5">
                {channel.email && <ContactEmail email={channel.email} />}
                {channel.links && (
                  <ul class="flex flex-wrap gap-x-5 gap-y-2">
                    {channel.links.map((link) => (
                      <li>
                        <SmartLink
                          href={link.href}
                          class="text-link inline-flex items-center gap-2"
                        >
                          {link.label}
                          <Icon name="external" class="size-4" strokeWidth={2} />
                        </SmartLink>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
