---
import ContactEmail from '../ContactEmail.astro';
import Icon from '../Icon.astro';
import SmartLink from '../SmartLink.astro';
import type { IconName } from '../../lib/icons';
import { owner } from '../../data/site';

type Channel = { label: string; description: string; href: string; icon: IconName; cta: string };

const channels: Channel[] = [
  {
    label: 'H3 Consulting Partners',
    description: 'For advisory, automation, and data & AI engagements.',
    href: 'https://h3consultingpartners.com',
    icon: 'briefcase',
    cta: 'h3consultingpartners.com',
  },
  {
    label: 'IFATC Companion',
    description: 'My flight-simulation companion app for iOS and Android.',
    href: 'https://apps.apple.com/us/app/ifatc-companion/id6785536132',
    icon: 'apps',
    cta: 'View on the App Store',
  },
  ...(owner.linkedinUrl
    ? [
        {
          label: 'LinkedIn',
          description: 'Professional profile and experience.',
          href: owner.linkedinUrl,
          icon: 'linkedin' as const,
          cta: 'View profile',
        },
      ]
    : []),
  ...(owner.githubUrl
    ? [
        {
          label: 'GitHub',
          description: 'Code, tools, and personal projects.',
          href: owner.githubUrl,
          icon: 'github' as const,
          cta: 'View profile',
        },
      ]
    : []),
];
---

<section
  id="connect"
  aria-labelledby="connect-title"
  class="border-t border-white/5 bg-midnight-950/40"
>
  <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <div class="card relative overflow-hidden bg-[radial-gradient(ellipse_at_top_left,rgba(38,132,237,0.16),transparent_60%)] p-6 sm:p-10 lg:p-14">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow text-accent-300">Connect</p>
          <h2 id="connect-title" class="section-title mt-3">
            Let’s connect
          </h2>
          <span class="mt-5 block h-1 w-10 rounded-full bg-accent-500" aria-hidden="true"></span>
          <p class="mt-6 text-lg leading-relaxed text-slate-300">
            For consulting engagements, the best way to reach me is through H3 Consulting Partners.
            I’m always glad to talk about engineering, industrial technology, and building practical
            products.
          </p>
          {owner.contactEmail && (
            <p class="mt-6 flex items-center gap-3 text-lg">
              <Icon name="mail" class="size-6 shrink-0 text-accent-500" />
              <ContactEmail email={owner.contactEmail} />
            </p>
          )}
        </div>

        <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
          {channels.map((channel) => (
            <li>
              <SmartLink
                href={channel.href}
                class="group flex h-full flex-col rounded-xl border border-white/10 bg-midnight-900/60 p-6 transition-colors hover:border-accent-500/60 hover:bg-midnight-900"
              >
                <Icon name={channel.icon} class="size-8 text-accent-500" strokeWidth={1.5} />
                <span class="mt-4 text-lg font-semibold text-white">{channel.label}</span>
                <span class="mt-1 text-slate-300">{channel.description}</span>
                <span class="mt-auto inline-flex items-center gap-2 pt-5 font-semibold text-accent-300">
                  {channel.cta}
                  <Icon name="external" class="size-4" strokeWidth={2} />
                </span>
              </SmartLink>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
