---
import ProjectCard from '../ProjectCard.astro';
import SectionHeading from '../SectionHeading.astro';
import { projects } from '../../data/content';

const visible = projects.filter((project) => project.published !== false);
const groups = [
  {
    title: 'Available now',
    items: visible.filter((project) => project.status === 'available'),
  },
  {
    title: 'In development',
    items: visible.filter((project) => project.status === 'in-development'),
  },
].filter((group) => group.items.length > 0);
---

<section id="projects" aria-labelledby="projects-title" class="border-t border-white/5">
  <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <SectionHeading eyebrow="Projects" title="Ventures and products" id="projects-title">
      <p>
        Independent work, separate from my corporate role: a consulting practice and software
        products in production on the web, iOS, and Android.
      </p>
    </SectionHeading>

    {groups.map((group) => (
      <div class="mt-14">
        <h3 class="text-xl font-semibold text-white">{group.title}</h3>
        <ul class="mt-6 grid gap-6 md:grid-cols-2">
          {group.items.map((project) => (
            <li class:list={[project.wide && 'md:col-span-2']}>
              <ProjectCard project={project} />
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
