---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { capabilities, currentRole, previousRoles } from '../../data/content';
---

<section
  id="experience"
  aria-labelledby="experience-title"
  class="border-t border-white/5 bg-midnight-950/40"
>
  <div class="mx-auto max-w-[86rem] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <SectionHeading eyebrow="Experience" title="Selected experience" id="experience-title">
      <p>
        Executive leadership in industrial software, built on a technical foundation in aerospace
        systems engineering and energy infrastructure.
      </p>
    </SectionHeading>

    {/* Current role */}
    <article class="card mt-12 overflow-hidden" aria-labelledby="current-role">
      <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-12 lg:gap-12 lg:p-10">
        <div class="lg:col-span-5">
          <p class="inline-flex items-center gap-2 rounded-full border border-accent-500/40 bg-accent-500/10 px-3 py-1 text-xs font-semibold tracking-wider text-accent-300 uppercase">
            <span class="size-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
            Current
          </p>
          <h3 id="current-role" class="mt-5 text-2xl font-bold text-white sm:text-[1.7rem]">
            {currentRole.role}
          </h3>
          <p class="mt-1 text-lg text-slate-300">{currentRole.organization}</p>
          <p class="mt-5 leading-relaxed text-slate-300">{currentRole.summary}</p>
        </div>
        {currentRole.highlights && (
          <ul class="space-y-4 border-white/10 lg:col-span-7 lg:border-l lg:pl-12">
            {currentRole.highlights.map((item) => (
              <li class="flex gap-3 leading-relaxed text-slate-300">
                <Icon name="check" class="mt-1 size-5 shrink-0 text-accent-500" strokeWidth={2} />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </article>

    {/* Earlier experience (undated pending owner confirmation of chronology) */}
    <h3 class="mt-16 text-xl font-semibold text-white">Earlier experience</h3>
    <ul class="mt-6 grid gap-5 md:grid-cols-3">
      {previousRoles.map((role) => (
        <li class="card flex flex-col p-6">
          <h4 class="text-lg font-semibold text-white">{role.organization}</h4>
          <p class="mt-1 text-sm font-medium text-accent-300">{role.role}</p>
          <p class="mt-4 leading-relaxed text-slate-300">{role.summary}</p>
        </li>
      ))}
    </ul>

    {/* Capabilities */}
    <h3 class="mt-16 text-xl font-semibold text-white">Capabilities</h3>
    <ul class="mt-6 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((capability) => (
        <li class="border-l-2 border-accent-500/70 pl-5">
          <h4 class="font-semibold text-white">{capability.title}</h4>
          <p class="mt-1.5 leading-relaxed text-slate-400">{capability.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
