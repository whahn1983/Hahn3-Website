---
import Icon from '../Icon.astro';
import SmartLink from '../SmartLink.astro';
import { keyLinks } from '../../data/content';
import { profile } from '../../data/site';
---

<section
  aria-labelledby="intro-title"
  class="mx-auto max-w-[86rem] px-5 pt-6 pb-20 sm:px-8 lg:px-12 lg:pb-28"
>
  <div class="grid gap-14 lg:grid-cols-2 lg:gap-0">
    <div class="lg:border-r lg:border-white/10 lg:pr-16">
      <h2 id="intro-title" class="text-3xl font-bold tracking-tight text-white sm:text-[2.1rem]">
        About
      </h2>
      <span class="mt-4 block h-1 w-10 rounded-full bg-accent-500" aria-hidden="true"></span>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300 sm:text-xl sm:leading-relaxed">
        {profile.intro}
      </p>
      <a href="/#about" class="text-link group mt-8 inline-flex items-center gap-2 text-lg">
        Learn more about my background
        <Icon
          name="arrow-right"
          class="size-5 transition-transform group-hover:translate-x-1"
          strokeWidth={2}
        />
      </a>
    </div>

    <div class="lg:pl-16">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-[2.1rem]">Key Links</h2>
      <ul class="mt-7 space-y-2">
        {keyLinks.map((link) => (
          <li>
            <SmartLink
              href={link.href}
              class="group -mx-3 flex items-start gap-5 rounded-lg px-3 py-2.5 transition-colors hover:bg-white/5"
            >
              <Icon
                name={link.icon}
                class="mt-0.5 size-8 shrink-0 text-slate-100"
                strokeWidth={1.5}
              />
              <span>
                <span class="flex items-center gap-2.5 text-lg font-semibold text-white group-hover:text-accent-300">
                  {link.label}
                  <Icon name="external" class="size-4 text-slate-400" strokeWidth={2} />
                </span>
                <span class="mt-0.5 block text-slate-300">{link.description}</span>
              </span>
            </SmartLink>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
