# Optional overrides for the owner-confirmed values in src/data/site.ts.
# Copy to `.env` for local builds. In GitHub Actions these come from repository
# *variables* (Settings → Secrets and variables → Actions → Variables), not secrets —
# they are published on the site. Leave a value empty to keep the default.

# Address shown (assembled client-side) in the Connect section.
PUBLIC_CONTACT_EMAIL=

# Exact public profile URLs, e.g. https://www.linkedin.com/in/<handle>/
PUBLIC_LINKEDIN_URL=
# e.g. https://github.com/<handle>
PUBLIC_GITHUB_URL=
