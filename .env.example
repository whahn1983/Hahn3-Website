# Optional public values used at build time. Copy to `.env` for local builds.
# In GitHub Actions these come from repository *variables* (Settings → Secrets and
# variables → Actions → Variables), not secrets — they are published on the site.
# Leave a value empty to hide that link.

# Address shown (lightly obfuscated) in the Connect section. Owner must approve.
PUBLIC_CONTACT_EMAIL=

# Exact public profile URLs, e.g. https://www.linkedin.com/in/<handle>/
PUBLIC_LINKEDIN_URL=
# e.g. https://github.com/<handle>
PUBLIC_GITHUB_URL=
